# Font

font-size = 13
font-family = "Fira Code"
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss05
font-feature = ss07
font-feature = cv02

# Appearance

theme = Catppuccin Mocha
macos-icon = retro
macos-window-buttons = hidden
macos-window-shadow = false
macos-titlebar-style = tabs
window-padding-balance = true

# Behaviour

shell-integration = zsh
mouse-hide-while-typing = true
macos-option-as-alt = true

# Keybindings

## Split panes
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+s=new_split:right
keybind = super+shift+s=new_split:down

## Resize panes
keybind = super+ctrl+arrow_down=unbind
keybind = super+ctrl+arrow_left=unbind
keybind = super+ctrl+arrow_right=unbind
keybind = super+ctrl+arrow_up=unbind
keybind = super+shift+j=resize_split:down,10
keybind = super+shift+h=resize_split:left,10
keybind = super+shift+l=resize_split:right,10
keybind = super+shift+k=resize_split:up,10

## Move between panes
keybind = super+alt+arrow_down=unbind
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+alt+arrow_up=unbind
keybind = super+j=goto_split:down
keybind = super+h=goto_split:left
keybind = super+l=goto_split:right
keybind = super+k=goto_split:up

## Tabs
keybind = super+t=new_tab
keybind = ctrl+shift+tab=unbind
keybind = super+shift+[=unbind
keybind = super+[=previous_tab
keybind = ctrl+tab=unbind
keybind = super+shift+]=unbind
keybind = super+]=next_tab
keybind = super+r=prompt_tab_title

